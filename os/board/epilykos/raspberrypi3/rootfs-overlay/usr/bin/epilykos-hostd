#!/usr/bin/python3
"""The narrow host interface the Epilykos container uses for system actions
(C-HOST-001): Restart, Shut down, Change Wi-Fi, the SSH controls, the
dashboard port, time zone and clock, Bluetooth pairing, and application
updates (C-UPDATE-002/004, epilykos_update).

Listens on /run/epilykos-host/host.sock, which only root and the
container's app user (gid 1000) can open; the container sees the same
directory. One JSON request per line, one JSON reply per line:

    {"action": "status"}                        also the clock and the SD card size
    {"action": "restart"} | {"action": "shutdown"}
    {"action": "wifi_setup"}                    open Bluetooth Wi-Fi setup for 15 min
    {"action": "ssh_enable"} | {"action": "ssh_disable"}
    {"action": "ssh_set_password", "password": "..."}
    {"action": "ssh_clear_password"}
    {"action": "ssh_add_key", "key": "ssh-ed25519 AAAA... name"}
    {"action": "ssh_remove_key", "fingerprint": "SHA256:..."}
    {"action": "set_port", "port": 8080}         dashboard port; restarts the app on it
    {"action": "set_timezone", "timezone": "Africa/Lagos", "restart": true}
                                                restarts the app when the zone changes
    {"action": "set_clock", "epoch": 1767225600}  for a box with no time server
    {"action": "bluetooth_status"} | {"action": "bluetooth_open"} | {"action": "bluetooth_close"}
    {"action": "bluetooth_pair", "address": "AA:BB:CC:DD:EE:FF"}
    {"action": "bluetooth_reply", "id": "...", "value": "1234"}   PIN, passkey or true
    {"action": "bluetooth_remove", "address": "AA:BB:CC:DD:EE:FF"}
    {"action": "update_status"}                 installing? how did the last update end?
    {"action": "update_check"}                  is a newer signed app release out?
    {"action": "update_apply", "target": "app"} install it (replies at once, then works)

Replies are {"ok": true, ...} or {"ok": false, "error": "..."}. Only these
actions exist; nothing else on the host can be reached through it. The
application checks that the caller is a signed-in administrator before
it asks. Passwords are never logged.
"""
import json
import os
import socketserver
import subprocess
import sys
import threading
import time

sys.path.insert(0, '/usr/lib/epilykos/python')
import epilykos_bluetooth as bluetooth  # noqa: E402
import epilykos_port as port  # noqa: E402
import epilykos_ssh as ssh  # noqa: E402
import epilykos_system as system  # noqa: E402
import epilykos_update as update  # noqa: E402

SOCKET = os.environ.get('EPILYKOS_HOST_SOCKET', '/run/epilykos-host/host.sock')
RUN_DIR = os.environ.get('EPILYKOS_RUN_DIR', '/run/epilykos')
SYSTEMCTL = os.environ.get('EPILYKOS_SYSTEMCTL', 'systemctl')
APP_GID = int(os.environ.get('EPILYKOS_APP_GID', '1000'))
WIFI_SETUP_S = 15 * 60
BLUETOOTH_ACTIONS = ('bluetooth_status', 'bluetooth_open', 'bluetooth_close', 'bluetooth_pair',
                     'bluetooth_reply', 'bluetooth_remove')
MAX_REQUEST = 16 * 1024


def log(msg):
    print(f'epilykos-hostd: {msg}', flush=True)


def systemctl(*args):
    subprocess.run([SYSTEMCTL, '--no-block', *args], check=False)


def os_version():
    try:
        with open('/usr/lib/epilykos/image.env') as f:
            for line in f:
                if line.startswith('EPILYKOS_OS_VERSION='):
                    return line.split('=', 1)[1].strip()
    except OSError:
        pass
    return ''


def wifi_setup_until():
    try:
        with open(os.path.join(RUN_DIR, 'wifi-setup-until')) as f:
            until = float(f.read().strip())
        return int(until) if until > time.time() else 0
    except (OSError, ValueError):
        return 0


def later(fn, delay=1.0):
    """Run fn after the reply has gone out (restart/shutdown)."""
    threading.Timer(delay, fn).start()


def handle(req):
    action = req.get('action')
    if action in BLUETOOTH_ACTIONS:
        return bluetooth.action(action, req)
    if action == 'status':
        return {'ok': True, 'appliance': True, 'os_version': os_version(),
                'wifi_setup_until': wifi_setup_until(), 'ssh': ssh.status(), 'port': port.read(),
                'clock': system.clock(), 'storage': system.storage()}
    if action == 'set_timezone':
        # The app gets TZ when its container starts (epilykos-run), so a new
        # zone needs a restart; the same zone again does not.
        changed = system.validate_zone(req.get('timezone')) != system.timezone()
        zone = system.set_timezone(req.get('timezone'))
        system.write_clock()
        if changed:
            log(f'time zone set to {zone} from Epilykos settings')
            if req.get('restart', True):
                later(lambda: systemctl('restart', 'epilykos.service'), delay=3)
        return {'ok': True, 'timezone': zone, 'restart_required': changed}
    if action == 'set_clock':
        return {'ok': True, 'clock': system.set_clock(req.get('epoch'))}
    if action == 'restart':
        log('restart requested from Epilykos settings')
        later(lambda: systemctl('reboot'))
        return {'ok': True}
    if action == 'shutdown':
        log('shutdown requested from Epilykos settings')
        later(lambda: systemctl('poweroff'))
        return {'ok': True}
    if action == 'wifi_setup':
        until = int(time.time()) + WIFI_SETUP_S
        os.makedirs(RUN_DIR, exist_ok=True)
        with open(os.path.join(RUN_DIR, 'wifi-setup-until'), 'w') as f:
            f.write(f'{until}\n')
        log('Wi-Fi setup over Bluetooth opened from Epilykos settings for 15 minutes')
        return {'ok': True, 'wifi_setup_until': until}
    if action == 'ssh_enable':
        ssh.set_enabled(True)
        systemctl('start', 'epilykos-sshd.service')
        log('SSH turned on from Epilykos settings')
        return {'ok': True, 'ssh': ssh.status()}
    if action == 'ssh_disable':
        ssh.set_enabled(False)
        systemctl('stop', 'epilykos-sshd.service')
        log('SSH turned off from Epilykos settings')
        return {'ok': True, 'ssh': ssh.status()}
    if action == 'ssh_set_password':
        ssh.set_password_hash(ssh.hash_password(req.get('password')))
        ssh.write_shadow()
        log('SSH password set from Epilykos settings')
        return {'ok': True, 'ssh': ssh.status()}
    if action == 'ssh_clear_password':
        ssh.clear_password()
        ssh.write_shadow()
        log('SSH password cleared from Epilykos settings')
        return {'ok': True, 'ssh': ssh.status()}
    if action == 'ssh_add_key':
        fp = ssh.add_key(req.get('key'))
        log(f'SSH key {fp} added from Epilykos settings')
        return {'ok': True, 'ssh': ssh.status()}
    if action == 'ssh_remove_key':
        ssh.remove_key(str(req.get('fingerprint', '')))
        log(f'SSH key {req.get("fingerprint")} removed from Epilykos settings')
        return {'ok': True, 'ssh': ssh.status()}
    if action == 'set_port':
        new = port.validate(req.get('port'))
        if new == port.read():
            return {'ok': True, 'port': new}
        if port.in_use(new):
            raise port.PortError(f'port {new} is already in use on the box')
        port.write(new)
        log(f'dashboard port set to {new} from Epilykos settings; restarting Epilykos')
        later(lambda: systemctl('restart', 'epilykos.service'))
        return {'ok': True, 'port': new}
    if action == 'update_status':
        return update.status()
    if action == 'update_check':
        return update.check()
    if action == 'update_apply':
        target = str(req.get('target', 'app'))
        log(f'{target} update requested from Epilykos settings')
        return update.apply(target, automatic=req.get('automatic') is True, sequence=req.get('sequence'), digest=req.get('digest'))
    return {'ok': False, 'error': 'unknown action'}


class Handler(socketserver.StreamRequestHandler):
    timeout = 60  # update_check fetches the signed manifest

    def handle(self):
        line = self.rfile.readline(MAX_REQUEST + 1)
        if len(line) > MAX_REQUEST:
            reply = {'ok': False, 'error': 'request too large'}
        else:
            try:
                req = json.loads(line or b'{}')
                if not isinstance(req, dict):
                    raise ValueError('not an object')
                reply = handle(req)
            except (ssh.SshError, port.PortError, update.UpdateError, system.SystemError, bluetooth.PairingError) as e:
                reply = {'ok': False, 'error': str(e)}
            except (ValueError, UnicodeError):
                reply = {'ok': False, 'error': 'malformed request'}
            except OSError as e:
                log(f'{type(e).__name__}: {e.strerror or e}')
                reply = {'ok': False, 'error': 'the host could not do that'}
            except Exception as e:  # noqa: BLE001 - always answer; never drop the connection unanswered
                log(f'unexpected {type(e).__name__} handling a request')
                reply = {'ok': False, 'error': 'the host could not do that'}
        self.wfile.write(json.dumps(reply).encode() + b'\n')


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def notify_ready():
    addr = os.environ.get('NOTIFY_SOCKET')
    if not addr:
        return
    if addr.startswith('@'):
        addr = '\0' + addr[1:]
    import socket
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
        s.sendto(b'READY=1', addr)


def main():
    os.makedirs(os.path.dirname(SOCKET), exist_ok=True)
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    server = Server(SOCKET, Handler)
    try:
        os.chown(SOCKET, 0, APP_GID)
    except PermissionError:
        pass  # tests run unprivileged
    os.chmod(SOCKET, 0o660)
    # Before epilykos.service starts: an update cut short goes back to the
    # last promoted image.
    try:
        update.recover()
    except OSError as e:
        log(f'update recovery: {e}')
    def write_clock():
        try:
            system.write_clock()
        except OSError as e:
            log(f'clock state: {e}')

    def clock_loop():
        while True:
            time.sleep(15)
            write_clock()
    # The container reads clock.json from its start, so write it before READY.
    write_clock()
    bluetooth.start()
    threading.Thread(target=clock_loop, daemon=True).start()
    log(f'listening on {SOCKET}')
    notify_ready()
    server.serve_forever()


if __name__ == '__main__':
    sys.exit(main())
