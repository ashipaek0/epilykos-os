# Wi-Fi (joined by iwd): DHCP and mDNS like Ethernet. Ethernet's lower
# route metric keeps it preferred when both are up.
[Match]
Type=wlan

[Network]
DHCP=yes
MulticastDNS=yes
LinkLocalAddressing=yes
IgnoreCarrierLoss=3s

[DHCPv4]
RouteMetric=600
UseDomains=yes
# The box keeps its own name (epilykos.local); a name from the router is
# refused anyway ("Could not set hostname: Access denied").
UseHostname=no
