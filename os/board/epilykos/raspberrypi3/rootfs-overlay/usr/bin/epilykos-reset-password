#!/usr/bin/python3
"""Set a new Epilykos dashboard password, for when it is forgotten.

Run it on the console, or over SSH as `sudo epilykos-reset-password`. It
asks for the new password twice, saves it the way the app does
(epilykos_dashboard.py), switches two-step sign-in off if it was on, and
restarts Epilykos so it takes effect.
"""
import getpass
import os
import subprocess
import sys

sys.path.insert(0, '/usr/lib/epilykos/python')
import epilykos_dashboard as dashboard  # noqa: E402

SYSTEMCTL = os.environ.get('EPILYKOS_SYSTEMCTL', 'systemctl')


def ask(prompt):
    if sys.stdin.isatty():
        return getpass.getpass(prompt)
    return sys.stdin.readline().rstrip('\r\n')  # piped, e.g. in tests


def main():
    if os.geteuid() != 0 and 'EPILYKOS_DASHBOARD_PASSWORD_FILE' not in os.environ:
        print('Run it as root: sudo epilykos-reset-password', file=sys.stderr)
        return 1
    password = ask('New dashboard password: ')
    if ask('Same again: ') != password:
        print("The two passwords don't match; nothing changed.", file=sys.stderr)
        return 1
    try:
        two_step = dashboard.set_password(password)
    except dashboard.PasswordError as e:
        print(f'Not changed: {e}.', file=sys.stderr)
        return 1
    subprocess.run([SYSTEMCTL, '--no-block', 'restart', 'epilykos.service'], check=False)
    print('Dashboard password changed.' + (' Two-step sign-in is switched off.' if two_step else '')
          + ' Epilykos is restarting; log in with the new password in a minute.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
