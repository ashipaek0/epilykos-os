# Default U-Boot environment for EpilykosOS on the Raspberry Pi 3B.
# Compiled into a raw env image by mkenvimage (BR2_TARGET_UBOOT_ENVIMAGE)
# and flashed to its own env partition — separate from both rootfs slots,
# so a slot switch never wipes the boot-attempt counters.
#
# RAUC's own uboot.sh/env backend is expected to update BOOT_ORDER and the
# BOOT_<slot>_LEFT counters when a new update is installed; boot.cmd only
# reads and decrements them.

BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=3
active_root=a
pending=0
fdtfile=broadcom/bcm2837-rpi-3-b.dtb
kernel_addr_r=0x02000000
fdt_addr_r=0x03000000
