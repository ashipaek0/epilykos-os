# Protocol-2 card (OS updates from Settings), on top of the board defconfig.
# os/build.sh appends this when EPILYKOS_BOOT_PROTOCOL=2. The default image
# stays protocol 1 until hardware acceptance.
BR2_EPILYKOS_BOOT_PROTOCOL_2=y
BR2_EPILYKOS_NATIVE_ENV_GUARD=y
# The slot's kernel and DTB are loaded by U-Boot's ext4 reader: only the
# features the loader tests prove it reads (tools/test_slot_boot.py).
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^metadata_csum_seed,^orphan_file"
# boot.scr comes from the checked slot script; it never loads Linux from BOOT.
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_EPILYKOS_PATH)/board/epilykos/raspberrypi3/boot-slot.cmd"
# Host RAUC signs the OS update package from this build's own rootfs
# (tools/build_os_bundle.py), so the package and the card carry the same bytes.
BR2_PACKAGE_HOST_RAUC=y
